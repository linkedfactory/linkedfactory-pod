<?xml version="1.0" encoding="UTF-8"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.linkedfactory</groupId>
		<artifactId>linkedfactory-parent</artifactId>
		<version>1.3.0-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>linkedfactory-launch-equinox</artifactId>
	<packaging>pom</packaging>

	<build>
		<plugins>
			<plugin>
				<groupId>at.bestsolution</groupId>
				<artifactId>maven-osgi-exec-plugin</artifactId>
				<version>0.0.3-SNAPSHOT</version>

				<executions>
					<execution>
						<phase>test</phase>
						<goals>
							<goal>exec-osgi</goal>
						</goals>
					</execution>
				</executions>

				<configuration>
					<mode>restart</mode>
					<programArguments>
						<programArgument>-console</programArgument>
						<programArgument>-consoleLog</programArgument>
						<programArgument>-application</programArgument>
						<programArgument>net.enilink.platform.core.application</programArgument>
						<programArgument>-clearPersistedState</programArgument>
						<programArgument>-clean</programArgument>
						<programArgument>-noExit</programArgument>
					</programArguments>
					<vmProperties>
						<property>
							<name>net.enilink.config</name>
							<value>${project.basedir}/../../configurations/default.ttl</value>
						</property>
						<property>
							<name>org.osgi.service.http.port</name>
							<value>8080</value>
						</property>
						<property>
							<name>eclipse.log.level</name>
							<value>INFO</value>
						</property>
					</vmProperties>
					<startLevels>
						<net.enilink.platform.lift>3</net.enilink.platform.lift>
						<org.eclipse.core.runtime>0</org.eclipse.core.runtime>
						<org.eclipse.equinox.common>2</org.eclipse.equinox.common>
						<org.apache.felix.scr>2</org.apache.felix.scr>
						<org.apache.felix.http.jetty12>3</org.apache.felix.http.jetty12>
						<org.eclipse.equinox.event>2</org.eclipse.equinox.event>
						<org.eclipse.equinox.simpleconfigurator>1</org.eclipse.equinox.simpleconfigurator>
						<org.apache.aries.spifly.dynamic.bundle>1</org.apache.aries.spifly.dynamic.bundle>
						<org.eclipse.equinox.slf4j>2</org.eclipse.equinox.slf4j>
						<org.eclipse.rap.http.registry>4</org.eclipse.rap.http.registry>
						<org.eclipse.rap.rwt.osgi>4</org.eclipse.rap.rwt.osgi>
					</startLevels>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>configure</id>

			<modules>
				<module>../..</module>
			</modules>

			<dependencies>
				<dependency>
					<groupId>net.enilink.platform</groupId>
					<artifactId>net.enilink.platform.equinox.feature</artifactId>
					<version>${enilink.version}</version>
					<type>pom</type>
				</dependency>
				<dependency>
					<groupId>io.github.linkedfactory</groupId>
					<artifactId>io.github.linkedfactory.service</artifactId>
					<version>${project.version}</version>
				</dependency>
			</dependencies>

			<build>
				<plugins>
					<plugin>
						<groupId>at.bestsolution</groupId>
						<artifactId>maven-osgi-exec-plugin</artifactId>
						<configuration>
							<mode>configure</mode>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>workbench</id>

			<dependencies>
				<dependency>
					<groupId>net.enilink.platform</groupId>
					<artifactId>net.enilink.platform.workbench.feature</artifactId>
					<version>${enilink.version}</version>
					<type>pom</type>
				</dependency>
			</dependencies>
		</profile>
	</profiles>

	<pluginRepositories>
		<pluginRepository>
			<id>efxclipse-releases</id>
			<url>https://maven.bestsolution.at/efxclipse-releases/</url>
		</pluginRepository>
		<pluginRepository>
			<id>efxclipse-snapshots</id>
			<url>https://maven.bestsolution.at/efxclipse-snapshots/</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>
</project>